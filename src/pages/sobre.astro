
---
import LayoutBase from '../layouts/LayoutBase.astro';
import Cartao from '../components/Cartao.astro';
import { empresa } from '../data/empresa.js';
---

<LayoutBase 
	titulo="Sobre Nós" 
	descricao={`Conheça a história e os valores da ${empresa.nome}.`}
>
	<section class="sobre-hero">
		<div class="hero-luz hero-luz-1"></div>
		<div class="hero-luz hero-luz-2"></div>

		<div class="container">
			<div class="sobre-conteudo">
				<span class="sobre-etiqueta">
					<span class="ponto"></span>
					CONHEÇA A YTALOCORPS
				</span>

				<h1>
					Tecnologia que transforma ideias em
					<span>soluções.</span>
				</h1>

				<p>{empresa.historia}</p>

				<div class="hero-assinatura">
					<span class="linha-assinatura"></span>
					<span>{empresa.nome} — Tecnologia e inovação</span>
				</div>
			</div>

			<div class="hero-visual" aria-hidden="true">
				<div class="visual-circulo circulo-externo"></div>
				<div class="visual-circulo circulo-meio"></div>
				<div class="visual-circulo circulo-interno"></div>

				<div class="visual-centro">
					<div class="visual-simbolo">YC</div>
					<span>INNOVATION</span>
				</div>

				<div class="visual-tag tag-topo">
					<span class="tag-indicador"></span>
					<span>IDEIAS</span>
				</div>

				<div class="visual-tag tag-baixo">
					<span>TECNOLOGIA</span>
					<span class="tag-indicador"></span>
				</div>

				<div class="visual-ponto ponto-1"></div>
				<div class="visual-ponto ponto-2"></div>
				<div class="visual-ponto ponto-3"></div>
			</div>
		</div>

		<div class="hero-rodape">
			<span>DESENVOLVIMENTO</span>
			<span class="rodape-separador"></span>
			<span>INOVAÇÃO</span>
			<span class="rodape-separador"></span>
			<span>TECNOLOGIA</span>
		</div>
	</section>

	<section class="secao-principios">
		<div class="container">
			<div class="cabecalho-principios">
				<div>
					<span class="secao-etiqueta">NOSSA ESSÊNCIA</span>
					<h2>O que nos <span>move.</span></h2>
				</div>

				<p>
					Construímos soluções com propósito, visão de futuro
					e compromisso com resultados.
				</p>
			</div>

			<div class="grid-missao-visao">
				<Cartao>
					<div class="principio-card">
						<div class="principio-topo">
							<span class="principio-numero">01</span>
							<div class="principio-icone">
								<svg viewBox="0 0 24 24" fill="none">
									<path d="M12 3L14.5 9.5L21 12L14.5 14.5L12 21L9.5 14.5L3 12L9.5 9.5L12 3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
								</svg>
							</div>
						</div>

						<h3>Missão</h3>
						<p>{empresa.missao}</p>
						<span class="principio-linha"></span>
					</div>
				</Cartao>

				<Cartao>
					<div class="principio-card">
						<div class="principio-topo">
							<span class="principio-numero">02</span>
							<div class="principio-icone">
								<svg viewBox="0 0 24 24" fill="none">
									<path d="M2 12C2 12 5.5 5 12 5C18.5 5 22 12 22 12C22 12 18.5 19 12 19C5.5 19 2 12 2 12Z" stroke="currentColor" stroke-width="1.6"/>
									<circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.6"/>
								</svg>
							</div>
						</div>

						<h3>Visão</h3>
						<p>{empresa.visao}</p>
						<span class="principio-linha"></span>
					</div>
				</Cartao>
			</div>
		</div>
	</section>

	<section class="secao-valores">
		<div class="container">
			<div class="cabecalho-valores">
				<span class="secao-etiqueta">NOSSO COMPROMISSO</span>
				<h2>Valores que definem <span>quem somos.</span></h2>
				<p>
					Os princípios que orientam nossas decisões e a maneira
					como desenvolvemos cada solução.
				</p>
			</div>

			<div class="grid-valores">
				{empresa.valores.map((valor, index) => (
					<Cartao destaque={true}>
						<div class="valor-card">
							<span class="valor-numero">
								{String(index + 1).padStart(2, '0')}
							</span>

							<div class="valor-detalhe"></div>

							<h3>{valor.titulo}</h3>
							<p>{valor.descricao}</p>
						</div>
					</Cartao>
				))}
			</div>
		</div>
	</section>
</LayoutBase>

<style>
/* =====================================================
   YTALOCORPS — SOBRE NÓS
   TECH EDITORIAL
===================================================== */

.sobre-hero,
.secao-principios,
.secao-valores {
	position: relative;
	overflow: hidden;
}

/* =====================================================
   HERO — FUNDO AZUL-MARINHO
===================================================== */

.sobre-hero {
	min-height: 620px;
	display: flex;
	align-items: center;
	padding: 100px 0 115px;

	background:
		radial-gradient(ellipse at 80% 45%, rgba(8, 102, 232, .24), transparent 38%),
		linear-gradient(120deg, #0d223b 0%, #12365b 55%, #102b49 100%);

	color: #fff;
}

.sobre-hero .container {
	position: relative;
	z-index: 2;

	display: grid;
	grid-template-columns: 1.15fr .85fr;
	align-items: center;
	gap: 55px;
}

/* Luzes decorativas */

.hero-luz {
	position: absolute;
	border-radius: 50%;
	filter: blur(90px);
	pointer-events: none;
}

.hero-luz-1 {
	width: 350px;
	height: 350px;
	top: -150px;
	right: 10%;
	background: rgba(22, 168, 234, .13);
}

.hero-luz-2 {
	width: 300px;
	height: 300px;
	bottom: -180px;
	left: 5%;
	background: rgba(8, 102, 232, .18);
}

/* Conteúdo */

.sobre-conteudo {
	max-width: 680px;
	animation: entradaTexto .9s ease both;
}

.sobre-etiqueta,
.secao-etiqueta {
	display: inline-flex;
	align-items: center;
	gap: 10px;

	font-size: .75rem;
	font-weight: 800;
	letter-spacing: 2px;
}

.sobre-etiqueta {
	margin-bottom: 28px;
	color: #8dcfff;
}

.ponto {
	width: 8px;
	height: 8px;
	border-radius: 50%;
	background: #16a8ea;
	box-shadow: 0 0 12px #16a8ea;
}

.sobre-conteudo h1 {
	max-width: 680px;
	margin: 0 0 27px;

	font-family: "Space Grotesk", sans-serif;
	font-size: clamp(2.8rem, 5.2vw, 5rem);
	font-weight: 800;
	line-height: 1.06;
	letter-spacing: -3px;
	color: #fff;
}

.sobre-conteudo h1 span {
	display: block;
	color: #42b9f4;
}

.sobre-conteudo > p {
	max-width: 620px;
	margin: 0;

	color: #c1d0e0;
	font-size: 1.05rem;
	line-height: 1.95;
}

.hero-assinatura {
	display: flex;
	align-items: center;
	gap: 14px;
	margin-top: 35px;

	color: #91aac4;
	font-size: .8rem;
	font-weight: 600;
	letter-spacing: .5px;
}

.linha-assinatura {
	width: 35px;
	height: 2px;
	background: #16a8ea;
}

/* =====================================================
   ELEMENTO GRÁFICO
===================================================== */

.hero-visual {
	position: relative;

	display: flex;
	align-items: center;
	justify-content: center;

	width: 100%;
	max-width: 430px;
	aspect-ratio: 1;

	margin: auto;

	animation: entradaVisual 1.1s .15s ease both;
}

.visual-circulo {
	position: absolute;
	border-radius: 50%;
}

.circulo-externo {
	width: 95%;
	height: 95%;
	border: 1px solid rgba(111, 190, 255, .18);
	animation: girar 35s linear infinite;
}

.circulo-externo::before,
.circulo-externo::after {
	content: "";
	position: absolute;
	width: 10px;
	height: 10px;
	border-radius: 50%;
	background: #16a8ea;
	box-shadow: 0 0 20px #16a8ea;
}

.circulo-externo::before {
	top: 12%;
	left: 18%;
}

.circulo-externo::after {
	right: 10%;
	bottom: 25%;
}

.circulo-meio {
	width: 72%;
	height: 72%;
	border: 1px dashed rgba(111, 190, 255, .35);
	animation: girar 45s linear infinite reverse;
}

.circulo-interno {
	width: 48%;
	height: 48%;
	border: 1px solid rgba(22, 168, 234, .3);

	background: radial-gradient(
		circle,
		rgba(22, 168, 234, .17),
		rgba(8, 102, 232, .04) 65%,
		transparent
	);

	box-shadow: 0 0 80px rgba(8, 102, 232, .13);
}

.visual-centro {
	position: relative;
	z-index: 2;

	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 8px;
}

.visual-simbolo {
	font-family: "Space Grotesk", sans-serif;
	font-size: clamp(4rem, 7vw, 6rem);
	font-weight: 800;
	letter-spacing: -8px;

	background: linear-gradient(135deg, #fff, #59c8ff);
	background-clip: text;
	-webkit-background-clip: text;
	color: transparent;

	filter: drop-shadow(0 5px 25px rgba(22, 168, 234, .2));
}

.visual-centro > span {
	font-size: .65rem;
	font-weight: 700;
	letter-spacing: 4px;
	color: #8dcfff;
}

.visual-tag {
	position: absolute;
	z-index: 3;

	display: flex;
	align-items: center;
	gap: 9px;

	padding: 11px 16px;

	border: 1px solid rgba(130, 200, 255, .22);
	border-radius: 30px;

	background: rgba(15, 48, 78, .8);
	backdrop-filter: blur(10px);

	color: #d5eaff;
	font-size: .65rem;
	font-weight: 800;
	letter-spacing: 1.5px;
}

.tag-topo {
	top: 15%;
	right: 0;
}

.tag-baixo {
	bottom: 17%;
	left: 0;
}

.tag-indicador {
	width: 6px;
	height: 6px;
	border-radius: 50%;
	background: #16a8ea;
	box-shadow: 0 0 10px #16a8ea;
}

.visual-ponto {
	position: absolute;
	width: 5px;
	height: 5px;
	border-radius: 50%;
	background: #6bcaff;
	box-shadow: 0 0 15px #16a8ea;
}

.ponto-1 { top: 7%; left: 48%; }
.ponto-2 { bottom: 12%; right: 27%; }
.ponto-3 { top: 40%; left: 3%; }

/* Rodapé do hero */

.hero-rodape {
	position: absolute;
	z-index: 2;

	bottom: 0;
	left: 0;

	display: flex;
	align-items: center;
	justify-content: center;
	gap: 20px;

	width: 100%;
	padding: 20px;

	border-top: 1px solid rgba(255, 255, 255, .09);

	color: #819ab5;
	font-size: .65rem;
	font-weight: 700;
	letter-spacing: 2px;
}

.rodape-separador {
	width: 4px;
	height: 4px;
	border-radius: 50%;
	background: #16a8ea;
}

/* =====================================================
   MISSÃO E VISÃO
===================================================== */

.secao-principios {
	padding: 105px 0 110px;

	background:
		radial-gradient(ellipse at 0% 20%, rgba(22, 168, 234, .07), transparent 35%),
		#f7faff;
}

.cabecalho-principios {
	display: flex;
	align-items: flex-end;
	justify-content: space-between;
	gap: 40px;

	margin-bottom: 48px;
}

.secao-etiqueta {
	margin-bottom: 17px;
	color: #0874d9;
}

.cabecalho-principios h2,
.cabecalho-valores h2 {
	margin: 0;

	font-family: "Space Grotesk", sans-serif;
	font-size: clamp(2.4rem, 4vw, 3.6rem);
	font-weight: 800;
	line-height: 1.12;
	letter-spacing: -2px;
	color: #12365b;
}

.cabecalho-principios h2 span,
.cabecalho-valores h2 span {
	color: #0874e8;
}

.cabecalho-principios > p {
	max-width: 390px;
	margin: 0 0 5px;

	color: #6b7e94;
	font-size: .98rem;
	line-height: 1.8;
}

.grid-missao-visao {
	display: grid;
	grid-template-columns: repeat(2, minmax(0, 1fr));
	gap: 25px;
}

.grid-missao-visao > * {
	position: relative;
	overflow: hidden;

	border: 1px solid #e1eaf5;
	border-radius: 22px;

	background: #fff;

	box-shadow: 0 12px 35px rgba(18, 54, 91, .045);

	transition:
		transform .35s ease,
		box-shadow .35s ease,
		border-color .35s ease;
}

.grid-missao-visao > *:hover {
	transform: translateY(-7px);
	border-color: #9bcfff;
	box-shadow: 0 22px 45px rgba(18, 54, 91, .09);
}

.principio-card {
	position: relative;
	padding: 35px 36px 40px;
}

.principio-topo {
	display: flex;
	align-items: center;
	justify-content: space-between;
	margin-bottom: 35px;
}

.principio-numero {
	font-family: "Space Grotesk", sans-serif;
	font-size: .85rem;
	font-weight: 800;
	letter-spacing: 2px;
	color: #8ba3bd;
}

.principio-icone {
	display: grid;
	place-items: center;

	width: 54px;
	height: 54px;

	border: 1px solid #dcecff;
	border-radius: 16px;

	background: #eff7ff;
	color: #0874e8;

	transition:
		background .3s ease,
		color .3s ease,
		transform .3s ease;
}

.principio-icone svg {
	width: 27px;
	height: 27px;
}

.grid-missao-visao > *:hover .principio-icone {
	transform: rotate(-8deg) scale(1.08);
	background: #0874e8;
	color: #fff;
}

.principio-card h3 {
	margin: 0 0 16px;

	font-family: "Space Grotesk", sans-serif;
	font-size: 1.7rem;
	font-weight: 800;
	color: #12365b;
}

.principio-card p {
	margin: 0;

	color: #687d95;
	font-size: .98rem;
	line-height: 1.9;
}

.principio-linha {
	display: block;

	width: 42px;
	height: 3px;

	margin-top: 27px;
	border-radius: 10px;

	background: linear-gradient(90deg, #0866e8, #16a8ea);

	transition: width .35s ease;
}

.grid-missao-visao > *:hover .principio-linha {
	width: 85px;
}

/* =====================================================
   VALORES
===================================================== */

.secao-valores {
	padding: 105px 0 115px;

	background:
		radial-gradient(ellipse at 100% 0%, rgba(22, 168, 234, .09), transparent 35%),
		linear-gradient(145deg, #eaf3ff, #f8fbff 55%, #edf5ff);
}

.cabecalho-valores {
	max-width: 720px;
	margin: 0 auto 55px;
	text-align: center;
}

.cabecalho-valores h2 {
	margin-bottom: 19px;
}

.cabecalho-valores > p {
	max-width: 580px;
	margin: 0 auto;

	color: #6b7e94;
	font-size: 1rem;
	line-height: 1.8;
}

.grid-valores {
	display: grid;
	grid-template-columns: repeat(auto-fit, minmax(235px, 1fr));
	gap: 20px;
}

.grid-valores > * {
	position: relative;
	overflow: hidden;

	border: 1px solid rgba(213, 228, 245, .9);
	border-radius: 20px;

	background: rgba(255, 255, 255, .9);

	box-shadow: 0 10px 30px rgba(18, 54, 91, .045);

	transition:
		transform .35s ease,
		box-shadow .35s ease,
		border-color .35s ease;
}

.grid-valores > *:hover {
	transform: translateY(-8px);
	border-color: #91caff;
	box-shadow: 0 20px 40px rgba(18, 54, 91, .09);
}

.valor-card {
	position: relative;
	min-height: 210px;
	padding: 29px 27px 32px;
}

.valor-numero {
	display: inline-block;
	margin-bottom: 28px;

	font-family: "Space Grotesk", sans-serif;
	font-size: .8rem;
	font-weight: 800;
	letter-spacing: 2px;
	color: #0b83e9;
}

.valor-detalhe {
	position: absolute;
	top: 34px;
	right: 28px;

	width: 34px;
	height: 34px;

	border: 1px solid #d6eaff;
	border-radius: 11px;

	background:
		linear-gradient(135deg, rgba(22, 168, 234, .12), rgba(8, 102, 232, .03));

	transition: transform .35s ease;
}

.valor-detalhe::before,
.valor-detalhe::after {
	content: "";
	position: absolute;
	background: #168ce7;
	border-radius: 5px;
}

.valor-detalhe::before {
	width: 13px;
	height: 2px;
	top: 15px;
	left: 10px;
}

.valor-detalhe::after {
	width: 2px;
	height: 13px;
	top: 10px;
	left: 15px;
}

.grid-valores > *:hover .valor-detalhe {
	transform: rotate(45deg);
}

.valor-card h3 {
	margin: 0 0 13px;

	font-family: "Space Grotesk", sans-serif;
	font-size: 1.25rem;
	font-weight: 800;
	color: #12365b;
}

.valor-card p {
	margin: 0;

	color: #6b7e94;
	font-size: .93rem;
	line-height: 1.8;
}

/* =====================================================
   ANIMAÇÕES
===================================================== */

@keyframes entradaTexto {
	from {
		opacity: 0;
		transform: translateY(25px);
	}
	to {
		opacity: 1;
		transform: translateY(0);
	}
}

@keyframes entradaVisual {
	from {
		opacity: 0;
		transform: scale(.88);
	}
	to {
		opacity: 1;
		transform: scale(1);
	}
}

@keyframes girar {
	from { transform: rotate(0deg); }
	to { transform: rotate(360deg); }
}

/* =====================================================
   RESPONSIVIDADE
===================================================== */

@media (max-width: 900px) {
	.sobre-hero {
		padding: 85px 0 105px;
	}

	.sobre-hero .container {
		grid-template-columns: 1fr .8fr;
		gap: 20px;
	}

	.hero-visual {
		max-width: 330px;
	}

	.cabecalho-principios {
		align-items: flex-start;
		flex-direction: column;
		gap: 20px;
	}
}

@media (max-width: 650px) {
	.sobre-hero {
		min-height: auto;
		padding: 75px 0 100px;
	}

	.sobre-hero .container {
		grid-template-columns: 1fr;
		gap: 45px;
	}

	.sobre-conteudo h1 {
		font-size: clamp(2.6rem, 11vw, 3.6rem);
		letter-spacing: -2px;
	}

	.sobre-conteudo > p {
		font-size: .98rem;
	}

	.hero-visual {
		max-width: 290px;
	}

	.hero-rodape {
		gap: 10px;
		font-size: .52rem;
		letter-spacing: 1px;
	}

	.secao-principios,
	.secao-valores {
		padding: 75px 0;
	}

	.cabecalho-principios h2,
	.cabecalho-valores h2 {
		font-size: 2.45rem;
		letter-spacing: -1.5px;
	}

	.grid-missao-visao {
		grid-template-columns: 1fr;
		gap: 17px;
	}

	.principio-card {
		padding: 29px 25px 32px;
	}

	.cabecalho-valores {
		margin-bottom: 38px;
	}

	.grid-valores {
		grid-template-columns: 1fr;
		gap: 16px;
	}

	.valor-card {
		min-height: auto;
		padding: 26px 24px 29px;
	}
}

/* =====================================================
   ACESSIBILIDADE
===================================================== */

@media (prefers-reduced-motion: reduce) {
	.sobre-conteudo,
	.hero-visual,
	.circulo-externo,
	.circulo-meio {
		animation: none !important;
	}

	.grid-missao-visao > *,
	.grid-valores > *,
	.principio-icone,
	.principio-linha,
	.valor-detalhe {
		transition: none !important;
	}
}
</style>
