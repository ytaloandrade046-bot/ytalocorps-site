
---
import LayoutBase from '../layouts/LayoutBase.astro';
import Cartao from '../components/Cartao.astro';
import { empresa } from '../data/empresa.js';
---

<LayoutBase 
	titulo="Nossa Equipe" 
	descricao={`Conheça os profissionais por trás da ${empresa.nome}.`}
>
	<section class="secao">
		<div class="container">
			<div class="cabecalho-secao">
				<h1>Nossa Equipe Técnica</h1>
				<p>Conheça os profissionais que transformam requisitos de negócio em soluções de software seguras e escaláveis</p>
			</div>

			<div class="grid-equipe">
				{empresa.equipe.map((membro) => (
					<Cartao>
						<div class="card-membro-conteudo">
							<img 
								src={membro.foto} 
								alt={membro.alt} 
								class="foto-perfil" 
								width="140" 
								height="140" 
							/>
							<div class="info-membro">
								<h3>{membro.nome}</h3>
								<span class="cargo">{membro.cargo}</span>
								<p class="descricao-membro">{membro.descricao}</p>
							</div>
						</div>
					</Cartao>
				))}
			</div>
		</div>
	</section>
</LayoutBase>

<style>
	/* =========================================
	   YTALOCORPS - EQUIPE
	   Futurista / Tech Premium
	========================================= */

	.secao {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		padding: 5.5rem 0 6rem;
		background:
			radial-gradient(ellipse at 5% 15%, rgba(22,168,234,.13), transparent 35%),
			radial-gradient(ellipse at 95% 85%, rgba(8,102,232,.09), transparent 35%),
			#f7faff;
	}

	.secao::before,
	.secao::after {
		content: "";
		position: absolute;
		z-index: -1;
		border-radius: 50%;
		pointer-events: none;
	}

	.secao::before {
		width: 420px;
		height: 420px;
		top: 5%;
		left: -300px;
		border: 1px solid rgba(8,102,232,.1);
		box-shadow:
			0 0 0 45px rgba(8,102,232,.025),
			0 0 0 90px rgba(8,102,232,.02);
		animation: orbitaFundo 18s linear infinite;
	}

	.secao::after {
		width: 350px;
		height: 350px;
		right: -260px;
		bottom: 5%;
		border: 1px solid rgba(22,168,234,.13);
		box-shadow:
			0 0 0 45px rgba(22,168,234,.025),
			0 0 0 90px rgba(22,168,234,.02);
		animation: orbitaFundo 22s linear infinite reverse;
	}

	.secao .container {
		position: relative;
		z-index: 1;
	}

	/* CABEÇALHO */

	.cabecalho-secao {
		max-width: 780px;
		margin: 0 auto 4.5rem;
		text-align: center;
		animation: revelarConteudo .9s cubic-bezier(.16,1,.3,1) both;
	}

	.cabecalho-secao h1 {
		position: relative;
		display: inline-block;
		margin: 0 0 1.5rem;
		color: #12365b;
		font-family: 'Space Grotesk', sans-serif;
		font-size: clamp(2.2rem,5vw,3.5rem);
		font-weight: 800;
		line-height: 1.15;
		letter-spacing: -1.8px;
	}

	.cabecalho-secao h1::after {
		content: "";
		position: absolute;
		left: 50%;
		bottom: -15px;
		width: 85px;
		height: 4px;
		border-radius: 10px;
		background: linear-gradient(90deg,#0866e8,#16a8ea);
		transform: translateX(-50%);
		animation: linhaBrilhante 3s ease-in-out infinite;
	}

	.cabecalho-secao p {
		max-width: 650px;
		margin: 0 auto;
		color: #63758c;
		font-size: 1.08rem;
		line-height: 1.9;
	}

	/* GRID */

	.grid-equipe {
		display: grid;
		grid-template-columns: repeat(2,minmax(0,1fr));
		gap: 2rem;
		max-width: 950px;
		margin: 0 auto;
		align-items: stretch;
	}

	/* CARDS */

	.grid-equipe > * {
		position: relative;
		min-width: 0;
		padding: 2.6rem 1.8rem;
		overflow: hidden;
		background: linear-gradient(145deg,#fff 0%,#fafdff 100%);
		border: 1px solid #e1eaf5;
		border-radius: 25px;
		box-shadow: 0 8px 28px rgba(18,54,91,.055);
		transition:
			transform .55s cubic-bezier(.16,1,.3,1),
			box-shadow .5s ease,
			border-color .4s ease;
		animation: revelarCard .9s cubic-bezier(.16,1,.3,1) both;
	}

	.grid-equipe > *:nth-child(2) { animation-delay: .12s; }
	.grid-equipe > *:nth-child(3) { animation-delay: .24s; }
	.grid-equipe > *:nth-child(4) { animation-delay: .36s; }

	/* Luz que percorre o cartão */

	.grid-equipe > *::before {
		content: "";
		position: absolute;
		z-index: 0;
		top: -100%;
		left: -70%;
		width: 45%;
		height: 300%;
		background: linear-gradient(
			90deg,
			transparent,
			rgba(22,168,234,.08),
			rgba(255,255,255,.65),
			transparent
		);
		transform: rotate(25deg);
		transition: left .9s ease;
		pointer-events: none;
	}

	/* Luz ambiente */

	.grid-equipe > *::after {
		content: "";
		position: absolute;
		top: -100px;
		right: -100px;
		width: 230px;
		height: 230px;
		border-radius: 50%;
		background: rgba(22,168,234,.15);
		filter: blur(55px);
		opacity: 0;
		transition: opacity .5s ease;
		pointer-events: none;
	}

	.grid-equipe > *:hover {
		transform: translateY(-12px) scale(1.015);
		border-color: rgba(8,102,232,.32);
		box-shadow:
			0 28px 65px rgba(18,54,91,.12),
			0 0 30px rgba(22,168,234,.08);
	}

	.grid-equipe > *:hover::before {
		left: 140%;
	}

	.grid-equipe > *:hover::after {
		opacity: 1;
	}

	/* CONTEÚDO */

	.card-membro-conteudo {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		height: 100%;
		text-align: center;
	}

	/* =========================================
	   FOTOS - MOLDURA DE ENERGIA
	========================================= */

	.foto-perfil {
		position: relative;
		z-index: 2;
		display: block;
		width: 150px;
		height: 150px;
		flex-shrink: 0;
		object-fit: cover;
		object-position: center;
		margin: 0 0 2rem;
		padding: 0;
		border: none;
		border-radius: 50%;
		background: #eaf5ff;
		box-shadow: 0 10px 30px rgba(8,102,232,.16);
		transition:
			transform .6s cubic-bezier(.16,1,.3,1),
			box-shadow .5s ease,
			filter .5s ease;
	}

	/*
	   Moldura criada com gradiente cônico.
	   O recorte central deixa a foto visível.
	*/

	.card-membro-conteudo::before {
		content: "";
		position: absolute;
		z-index: 1;
		top: -9px;
		left: 50%;
		width: 168px;
		height: 168px;
		border-radius: 50%;
		background: conic-gradient(
			from 0deg,
			#0866e8,
			#16a8ea,
			#8ceaff,
			#0866e8,
			#12365b,
			#16a8ea,
			#0866e8
		);
		transform: translateX(-50%);
		animation: energiaGirar 5s linear infinite;
		-webkit-mask: radial-gradient(
			farthest-side,
			transparent calc(100% - 3px),
			#000 calc(100% - 2px)
		);
		mask: radial-gradient(
			farthest-side,
			transparent calc(100% - 3px),
			#000 calc(100% - 2px)
		);
		filter: drop-shadow(0 0 5px rgba(22,168,234,.4));
		pointer-events: none;
	}

	/* Segundo anel com movimento independente */

	.card-membro-conteudo::after {
		content: "";
		position: absolute;
		z-index: 0;
		top: -17px;
		left: 50%;
		width: 184px;
		height: 184px;
		border: 1px solid rgba(8,102,232,.2);
		border-radius: 50%;
		transform: translateX(-50%);
		animation: anelRespirar 4s ease-in-out infinite;
		pointer-events: none;
	}

	/* Hover da foto */

	.grid-equipe > *:hover .foto-perfil {
		transform: scale(1.09) rotate(-3deg);
		filter: saturate(1.18) contrast(1.03);
		box-shadow:
			0 15px 40px rgba(8,102,232,.28),
			0 0 35px rgba(22,168,234,.2);
	}

	.grid-equipe > *:hover .card-membro-conteudo::before {
		animation-duration: 1.8s;
		filter: drop-shadow(0 0 9px rgba(22,168,234,.85));
	}

	.grid-equipe > *:hover .card-membro-conteudo::after {
		border-color: rgba(22,168,234,.55);
		animation-duration: 1.5s;
	}

	/* INFORMAÇÕES */

	.info-membro {
		position: relative;
		z-index: 2;
		width: 100%;
	}

	.info-membro h3 {
		margin: 0 0 .7rem;
		color: #12365b;
		font-family: 'Space Grotesk',sans-serif;
		font-size: 1.4rem;
		font-weight: 700;
		line-height: 1.3;
		transition: color .35s ease;
	}

	.grid-equipe > *:hover .info-membro h3 {
		color: #0866e8;
	}

	/* CARGO */

	.cargo {
		position: relative;
		display: inline-block;
		margin-bottom: 1.2rem;
		padding: .5rem 1rem;
		overflow: hidden;
		color: #0866e8;
		background: linear-gradient(110deg,rgba(8,102,232,.07),rgba(22,168,234,.13));
		border: 1px solid rgba(8,102,232,.14);
		border-radius: 50px;
		font-size: .75rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: .8px;
		transition:
			color .35s ease,
			background .35s ease,
			transform .35s ease,
			box-shadow .35s ease;
	}

	.cargo::after {
		content: "";
		position: absolute;
		top: -50%;
		left: -100%;
		width: 50%;
		height: 200%;
		background: rgba(255,255,255,.5);
		transform: rotate(25deg);
		transition: left .65s ease;
	}

	.grid-equipe > *:hover .cargo {
		color: #fff;
		background: linear-gradient(100deg,#0866e8,#16a8ea);
		border-color: transparent;
		transform: translateY(-3px);
		box-shadow: 0 6px 18px rgba(8,102,232,.2);
	}

	.grid-equipe > *:hover .cargo::after {
		left: 150%;
	}

	.descricao-membro {
		margin: 0;
		color: #63758c;
		font-size: .94rem;
		line-height: 1.85;
		transition: color .35s ease;
	}

	.grid-equipe > *:hover .descricao-membro {
		color: #526a84;
	}

	/* =========================================
	   ANIMAÇÕES
	========================================= */

	@keyframes energiaGirar {
		to {
			transform: translateX(-50%) rotate(360deg);
		}
	}

	@keyframes anelRespirar {
		0%, 100% {
			transform: translateX(-50%) scale(.97);
			opacity: .45;
		}
		50% {
			transform: translateX(-50%) scale(1.06);
			opacity: .9;
		}
	}

	@keyframes orbitaFundo {
		to {
			transform: rotate(360deg);
		}
	}

	@keyframes linhaBrilhante {
		0%, 100% {
			box-shadow: 0 0 5px rgba(22,168,234,.15);
		}
		50% {
			box-shadow: 0 0 18px rgba(22,168,234,.65);
		}
	}

	@keyframes revelarConteudo {
		from {
			opacity: 0;
			transform: translateY(35px);
			filter: blur(5px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
			filter: blur(0);
		}
	}

	@keyframes revelarCard {
		from {
			opacity: 0;
			transform: translateY(45px) scale(.96);
			filter: blur(4px);
		}
		to {
			opacity: 1;
			transform: translateY(0) scale(1);
			filter: blur(0);
		}
	}

	/* RESPONSIVIDADE */

	@media (max-width: 768px) {
		.secao {
			padding: 4rem 0;
		}

		.cabecalho-secao {
			margin-bottom: 3.5rem;
		}

		.grid-equipe {
			gap: 1.5rem;
			max-width: 540px;
		}

		.grid-equipe > * {
			padding: 2rem 1.3rem;
		}

		.foto-perfil {
			width: 135px;
			height: 135px;
		}

		.card-membro-conteudo::before {
			width: 153px;
			height: 153px;
			top: -9px;
		}

		.card-membro-conteudo::after {
			width: 169px;
			height: 169px;
			top: -17px;
		}
	}

	@media (max-width: 480px) {
		.secao {
			padding: 3.5rem 0;
		}

		.cabecalho-secao h1 {
			font-size: 2.1rem;
			letter-spacing: -1px;
		}

		.cabecalho-secao p {
			font-size: .96rem;
		}

		.grid-equipe {
			grid-template-columns: 1fr;
			gap: 1.4rem;
		}

		.grid-equipe > * {
			padding: 2.3rem 1.5rem;
		}

		.foto-perfil {
			width: 145px;
			height: 145px;
		}

		.card-membro-conteudo::before {
			width: 163px;
			height: 163px;
		}

		.card-membro-conteudo::after {
			width: 177px;
			height: 177px;
		}
	}

	/* ACESSIBILIDADE */

	@media (prefers-reduced-motion: reduce) {
		.secao::before,
		.secao::after,
		.cabecalho-secao,
		.cabecalho-secao h1::after,
		.grid-equipe > *,
		.card-membro-conteudo::before,
		.card-membro-conteudo::after {
			animation: none !important;
		}

		.grid-equipe > *,
		.foto-perfil,
		.info-membro h3,
		.cargo,
		.descricao-membro {
			transition: none !important;
		}
	}
</style>
