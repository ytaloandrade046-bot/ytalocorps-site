
---
import LayoutBase from '../layouts/LayoutBase.astro';
import Cartao from '../components/Cartao.astro';
import { empresa } from '../data/empresa.js';
---

<LayoutBase 
	titulo="Fale Conosco" 
	descricao={`Entre em contato com a ${empresa.nome}.`}
>
	<section class="secao">
		<div class="container">
			<div class="cabecalho-secao">
				<h1>Fale Conosco</h1>
				<p>Deseja construir uma solução de software sob medida para o seu negócio? Entre em contato com a {empresa.nome}!</p>
			</div>

			<div class="grid-contato">
				<Cartao>
					<h2>Nossa Sede</h2>
					<address>
						{empresa.contato.endereco.logradouro}, {empresa.contato.endereco.complemento}<br/>
						{empresa.contato.endereco.bairro}<br/>
						{empresa.contato.endereco.cidadeEstado}<br/>
						CEP: {empresa.contato.endereco.cep}
					</address>
				</Cartao>

				<Cartao>
					<h2>Canais Digitais</h2>
					<p><strong>E-mail:</strong> <a href={`mailto:${empresa.contato.email}`}>{empresa.contato.email}</a></p>
					<p><strong>Telefone:</strong> {empresa.contato.telefone}</p>
				</Cartao>
			</div>
		</div>
	</section>
</LayoutBase>

<style>
	/* =========================================
	   CONTATO YTALOCORPS
	   Identidade visual azul + ciano
	   Tema claro e sofisticado
	========================================= */

	.secao {
		position: relative;
		overflow: hidden;
		min-height: 70vh;
		padding: 5.5rem 0 6rem;
		background:
			radial-gradient(
				circle at 8% 12%,
				rgba(22, 168, 234, 0.09),
				transparent 28%
			),
			radial-gradient(
				circle at 95% 85%,
				rgba(8, 102, 232, 0.07),
				transparent 30%
			),
			#f7faff;
	}

	.secao .container {
		position: relative;
		z-index: 1;
	}

	/* CABEÇALHO */

	.cabecalho-secao {
		max-width: 780px;
		margin: 0 auto 4rem;
		text-align: center;
		animation: contatoEntrada 0.8s ease both;
	}

	.cabecalho-secao h1 {
		position: relative;
		display: inline-block;
		margin: 0 0 1.5rem;
		color: #12365b;
		font-family: 'Space Grotesk', sans-serif;
		font-size: clamp(2.3rem, 5vw, 3.5rem);
		font-weight: 800;
		line-height: 1.15;
		letter-spacing: -1.8px;
	}

	.cabecalho-secao h1::after {
		content: "";
		position: absolute;
		left: 50%;
		bottom: -15px;
		width: 85px;
		height: 5px;
		border-radius: 10px;
		background: linear-gradient(90deg, #0866e8, #16a8ea);
		transform: translateX(-50%);
	}

	.cabecalho-secao p {
		max-width: 680px;
		margin: 0 auto;
		color: #63758c;
		font-size: 1.08rem;
		line-height: 1.9;
	}

	/* GRID */

	.grid-contato {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2rem;
		max-width: 950px;
		margin: 0 auto;
		align-items: stretch;
	}

	/* CARDS */

	.grid-contato > * {
		position: relative;
		min-width: 0;
		padding: 2.5rem;
		overflow: hidden;
		background: linear-gradient(
			145deg,
			#ffffff 0%,
			#fafdff 100%
		);
		border: 1px solid #e1eaf5;
		border-radius: 22px;
		box-shadow:
			0 8px 25px rgba(18, 54, 91, 0.06),
			0 2px 6px rgba(18, 54, 91, 0.03);
		transition:
			transform 0.35s ease,
			box-shadow 0.35s ease,
			border-color 0.35s ease;
		animation: contatoEntrada 0.8s ease both;
	}

	.grid-contato > *:nth-child(2) {
		animation-delay: 0.15s;
	}

	.grid-contato > *::before {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 4px;
		background: linear-gradient(90deg, #0866e8, #16a8ea);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.4s ease;
	}

	.grid-contato > *:hover {
		transform: translateY(-8px);
		border-color: rgba(8, 102, 232, 0.3);
		box-shadow:
			0 22px 45px rgba(18, 54, 91, 0.11),
			0 8px 18px rgba(8, 102, 232, 0.06);
	}

	.grid-contato > *:hover::before {
		transform: scaleX(1);
	}

	/* TÍTULOS */

	.grid-contato h2 {
		position: relative;
		margin: 0 0 1.6rem;
		padding-left: 1rem;
		color: #12365b;
		font-family: 'Space Grotesk', sans-serif;
		font-size: 1.45rem;
		font-weight: 700;
		line-height: 1.3;
	}

	.grid-contato h2::before {
		content: "";
		position: absolute;
		top: 2px;
		left: 0;
		width: 4px;
		height: 25px;
		border-radius: 5px;
		background: linear-gradient(180deg, #0866e8, #16a8ea);
	}

	/* ENDEREÇO */

	.grid-contato address {
		color: #63758c;
		font-size: 1rem;
		font-style: normal;
		line-height: 2;
	}

	/* CANAIS DIGITAIS */

	.grid-contato p {
		margin: 0 0 1rem;
		padding: 0.9rem 1rem;
		color: #63758c;
		background: #f4f8fd;
		border: 1px solid #e8eff8;
		border-radius: 12px;
		font-size: 0.96rem;
		line-height: 1.7;
		transition:
			background 0.3s ease,
			border-color 0.3s ease,
			transform 0.3s ease;
		overflow-wrap: anywhere;
	}

	.grid-contato p:hover {
		background: #edf5ff;
		border-color: rgba(8, 102, 232, 0.2);
		transform: translateX(4px);
	}

	.grid-contato p:last-child {
		margin-bottom: 0;
	}

	.grid-contato strong {
		color: #12365b;
		font-weight: 700;
	}

	.grid-contato a {
		color: #0866e8;
		font-weight: 600;
		text-decoration: none;
		transition: color 0.3s ease;
	}

	.grid-contato a:hover {
		color: #16a8ea;
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	/* ANIMAÇÕES */

	@keyframes contatoEntrada {
		from {
			opacity: 0;
			transform: translateY(25px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	/* RESPONSIVIDADE */

	@media (max-width: 768px) {
		.secao {
			padding: 4rem 0;
		}

		.cabecalho-secao {
			margin-bottom: 3rem;
		}

		.grid-contato {
			grid-template-columns: 1fr;
			gap: 1.5rem;
			max-width: 550px;
		}

		.grid-contato > * {
			padding: 2rem;
		}
	}

	@media (max-width: 480px) {
		.secao {
			padding: 3.5rem 0;
		}

		.cabecalho-secao h1 {
			font-size: 2.2rem;
			letter-spacing: -1px;
		}

		.cabecalho-secao p {
			font-size: 0.96rem;
		}

		.grid-contato > * {
			padding: 1.6rem;
			border-radius: 18px;
		}

		.grid-contato h2 {
			font-size: 1.3rem;
		}

		.grid-contato address,
		.grid-contato p {
			font-size: 0.92rem;
		}
	}

	/* ACESSIBILIDADE */

	@media (prefers-reduced-motion: reduce) {
		.cabecalho-secao,
		.grid-contato > * {
			animation: none;
		}

		.grid-contato > *,
		.grid-contato p,
		.grid-contato a {
			transition: none;
		}
	}
</style>
