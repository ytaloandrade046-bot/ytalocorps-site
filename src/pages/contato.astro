
---
import LayoutBase from '../layouts/LayoutBase.astro';
import Cartao from '../components/Cartao.astro';
import { empresa } from '../data/empresa.js';
---

<LayoutBase
	titulo="Fale Conosco"
	descricao={`Entre em contato com a ${empresa.nome}.`}
>
	<section class="contato-hero">
		<div class="hero-grade"></div>
		<div class="hero-orb orb-1"></div>
		<div class="hero-orb orb-2"></div>

		<div class="container hero-container">
			<div class="hero-texto">
				<span class="sobrelinha">
					<span class="ponto"></span>
					ESTAMOS À DISPOSIÇÃO
				</span>

				<h1>
					Vamos transformar<br />
					<span>ideias em realidade.</span>
				</h1>

				<p>
					Tem um projeto em mente ou precisa de uma solução tecnológica?
					Estamos prontos para ouvir suas ideias e construir algo extraordinário.
				</p>

				<a href="#informacoes" class="hero-link">
					Conheça nossos canais
					<span>↓</span>
				</a>
			</div>

			<div class="hero-visual" aria-hidden="true">
				<div class="visual-circulo circulo-externo"></div>
				<div class="visual-circulo circulo-meio"></div>
				<div class="visual-circulo circulo-interno"></div>

				<div class="visual-centro">
					<span>YC</span>
					<small>LET'S CONNECT</small>
				</div>

				<div class="visual-ponto ponto-a"></div>
				<div class="visual-ponto ponto-b"></div>
				<div class="visual-ponto ponto-c"></div>

				<div class="visual-legenda legenda-a">
					<span class="legenda-linha"></span>
					<span>INOVAÇÃO</span>
				</div>

				<div class="visual-legenda legenda-b">
					<span class="legenda-linha"></span>
					<span>TECNOLOGIA</span>
				</div>
			</div>
		</div>

		<div class="hero-rodape">
			<span>YTALOCORPS</span>
			<span>IDEIAS EM CÓDIGO, SOLUÇÕES EM REALIDADE.</span>
		</div>
	</section>

	<section class="contato-conteudo" id="informacoes">
		<div class="container">
			<div class="conteudo-cabecalho">
				<div>
					<span class="secao-etiqueta">CANAIS DE ATENDIMENTO</span>
					<h2>Entre em <span>contato.</span></h2>
				</div>

				<p>
					Escolha um dos nossos canais e encontre as informações necessárias
					para falar com a equipe da {empresa.nome}.
				</p>
			</div>

			<div class="grid-contato">
				<article class="contato-card card-sede">
					<div class="card-topo">
						<div class="card-icone">
							<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
								<path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-5h6v5M9 9h.01M15 9h.01M9 12h.01M15 12h.01" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
							</svg>
						</div>
						<span class="card-numero">01</span>
					</div>

					<div class="card-conteudo">
						<span class="card-etiqueta">ONDE ESTAMOS</span>
						<h3>Nossa Sede</h3>
						<p class="card-descricao">
							Conheça nossa localização e saiba onde encontrar a {empresa.nome}.
						</p>

						<div class="endereco">
							<div class="endereco-linha">
								<span class="endereco-marcador"></span>
								<div>
									<strong>Endereço</strong>
									<p>
										{empresa.contato.endereco.logradouro},
										{empresa.contato.endereco.complemento}
									</p>
								</div>
							</div>

							<div class="endereco-linha">
								<span class="endereco-marcador"></span>
								<div>
									<strong>Bairro</strong>
									<p>{empresa.contato.endereco.bairro}</p>
								</div>
							</div>

							<div class="endereco-linha">
								<span class="endereco-marcador"></span>
								<div>
									<strong>Cidade</strong>
									<p>{empresa.contato.endereco.cidadeEstado}</p>
								</div>
							</div>

							<div class="endereco-linha">
								<span class="endereco-marcador"></span>
								<div>
									<strong>CEP</strong>
									<p>{empresa.contato.endereco.cep}</p>
								</div>
							</div>
						</div>
					</div>

					<div class="card-rodape">
						<span>LOCALIZAÇÃO</span>
						<span class="seta-card">↗</span>
					</div>
				</article>

				<article class="contato-card card-digital">
					<div class="card-topo">
						<div class="card-icone">
							<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
								<path d="M3 6.5A2.5 2.5 0 0 1 5.5 4h13A2.5 2.5 0 0 1 21 6.5v11a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 17.5v-11Z" stroke="currentColor" stroke-width="1.7"/>
								<path d="m4 6 8 7 8-7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
							</svg>
						</div>
						<span class="card-numero">02</span>
					</div>

					<div class="card-conteudo">
						<span class="card-etiqueta">FALE COM A GENTE</span>
						<h3>Canais Digitais</h3>
						<p class="card-descricao">
							Estamos conectados para conversar sobre suas ideias e projetos.
						</p>

						<div class="canal-item">
							<div class="canal-icone">
								<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
									<rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.7"/>
									<path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
								</svg>
							</div>
							<div class="canal-info">
								<span>E-MAIL</span>
								<a href={`mailto:${empresa.contato.email}`}>
									{empresa.contato.email}
								</a>
							</div>
							<span class="canal-seta">↗</span>
						</div>

						<div class="canal-item">
							<div class="canal-icone">
								<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
									<path d="M21 16.5v3a1.5 1.5 0 0 1-1.65 1.5 18.8 18.8 0 0 1-8.2-2.92 18.5 18.5 0 0 1-5.7-5.7A18.8 18.8 0 0 1 2.53 4.15 1.5 1.5 0 0 1 4.02 2.5h3a1.5 1.5 0 0 1 1.5 1.29c.1.96.34 1.9.7 2.8a1.5 1.5 0 0 1-.34 1.58L7.6 9.45a15 15 0 0 0 5.7 5.7l1.28-1.28a1.5 1.5 0 0 1 1.58-.34c.9.36 1.84.6 2.8.7A1.5 1.5 0 0 1 21 16.5Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
								</svg>
							</div>
							<div class="canal-info">
								<span>TELEFONE</span>
								<p>{empresa.contato.telefone}</p>
							</div>
							<span class="canal-seta">↗</span>
						</div>
					</div>

					<div class="card-rodape">
						<span>CONEXÃO DIRETA</span>
						<span class="seta-card">↗</span>
					</div>
				</article>
			</div>
		</div>
	</section>

	<section class="contato-final">
		<div class="container final-container">
			<div>
				<span class="secao-etiqueta">SEU PRÓXIMO PROJETO COMEÇA AQUI</span>
				<h2>Boas ideias merecem<br /><span> sair do papel.</span></h2>
			</div>

			<a href={`mailto:${empresa.contato.email}`} class="final-botao">
				Entre em contato
				<span>↗</span>
			</a>
		</div>
	</section>
</LayoutBase>

<style>
	/* =========================================
	   YTALOCORPS — CONTATO
	   TECH EDITORIAL / AZUL + CIANO
	========================================= */

	.contato-hero {
		position: relative;
		min-height: 510px;
		overflow: hidden;
		display: flex;
		align-items: center;
		background:
			radial-gradient(ellipse at 75% 45%, rgba(8, 102, 232, 0.22), transparent 38%),
			linear-gradient(115deg, #0d223b 0%, #12365b 55%, #102b49 100%);
		color: #fff;
	}

	.hero-grade {
		position: absolute;
		inset: 0;
		opacity: 0.12;
		background-image:
			linear-gradient(rgba(255,255,255,.16) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255,255,255,.16) 1px, transparent 1px);
		background-size: 55px 55px;
		mask-image: linear-gradient(90deg, transparent, #000 35%, #000 85%, transparent);
	}

	.hero-orb {
		position: absolute;
		border-radius: 50%;
		pointer-events: none;
		filter: blur(1px);
	}

	.orb-1 {
		width: 350px;
		height: 350px;
		top: -220px;
		right: 10%;
		background: rgba(22, 168, 234, 0.12);
	}

	.orb-2 {
		width: 280px;
		height: 280px;
		bottom: -220px;
		left: 8%;
		background: rgba(8, 102, 232, 0.16);
	}

	.hero-container {
		position: relative;
		z-index: 2;
		width: 100%;
		display: grid;
		grid-template-columns: 1.15fr 0.85fr;
		align-items: center;
		gap: 3rem;
		padding-top: 5rem;
		padding-bottom: 5rem;
	}

	.hero-texto {
		animation: contatoTextoEntrada 0.9s ease both;
	}

	.sobrelinha,
	.secao-etiqueta {
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
		color: #57c5f3;
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 2.2px;
	}

	.ponto {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #42b9f4;
		box-shadow: 0 0 14px rgba(66, 185, 244, 0.9);
		animation: pulsar 2s ease-in-out infinite;
	}

	.hero-texto h1 {
		margin: 1.5rem 0 1.3rem;
		color: #fff;
		font-family: 'Space Grotesk', sans-serif;
		font-size: clamp(2.7rem, 5.2vw, 4.5rem);
		font-weight: 800;
		line-height: 1.07;
		letter-spacing: -2.7px;
	}

	.hero-texto h1 span {
		color: #42b9f4;
	}

	.hero-texto > p {
		max-width: 560px;
		margin: 0;
		color: #c1d0e0;
		font-size: 1.05rem;
		line-height: 1.9;
	}

	.hero-link {
		display: inline-flex;
		align-items: center;
		gap: 1.2rem;
		margin-top: 2.2rem;
		padding-bottom: 0.55rem;
		color: #fff;
		border-bottom: 1px solid rgba(66, 185, 244, 0.6);
		font-size: 0.9rem;
		font-weight: 700;
		text-decoration: none;
		transition: gap 0.3s ease, color 0.3s ease;
	}

	.hero-link:hover {
		gap: 1.8rem;
		color: #57c5f3;
	}

	.hero-link span {
		color: #42b9f4;
		font-size: 1.2rem;
	}

	/* ELEMENTO VISUAL */

	.hero-visual {
		position: relative;
		width: min(100%, 390px);
		aspect-ratio: 1;
		margin: 0 auto;
		display: grid;
		place-items: center;
		animation: contatoVisualEntrada 1.1s ease both;
	}

	.visual-circulo {
		position: absolute;
		border: 1px solid rgba(66, 185, 244, 0.3);
		border-radius: 50%;
	}

	.circulo-externo {
		inset: 3%;
		border-style: dashed;
		animation: girarContato 35s linear infinite;
	}

	.circulo-meio {
		inset: 14%;
		border-color: rgba(66, 185, 244, 0.5);
		animation: girarContato 24s linear infinite reverse;
	}

	.circulo-interno {
		inset: 25%;
		border-color: rgba(255, 255, 255, 0.15);
		box-shadow: 0 0 65px rgba(8, 102, 232, 0.18);
	}

	.visual-centro {
		position: relative;
		z-index: 2;
		width: 46%;
		aspect-ratio: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		border: 1px solid rgba(66, 185, 244, 0.45);
		border-radius: 50%;
		background: linear-gradient(145deg, rgba(22, 168, 234, 0.2), rgba(8, 102, 232, 0.08));
		box-shadow: 0 0 65px rgba(22, 168, 234, 0.15), inset 0 0 30px rgba(22, 168, 234, 0.1);
		backdrop-filter: blur(8px);
	}

	.visual-centro > span {
		color: #fff;
		font-family: 'Space Grotesk', sans-serif;
		font-size: 3.6rem;
		font-weight: 800;
		letter-spacing: -4px;
	}

	.visual-centro small {
		color: #57c5f3;
		font-size: 0.56rem;
		font-weight: 800;
		letter-spacing: 2px;
	}

	.visual-ponto {
		position: absolute;
		z-index: 3;
		width: 11px;
		height: 11px;
		border: 2px solid #102b49;
		border-radius: 50%;
		background: #42b9f4;
		box-shadow: 0 0 15px rgba(66, 185, 244, 0.9);
	}

	.ponto-a { top: 12%; left: 30%; }
	.ponto-b { right: 9%; top: 48%; }
	.ponto-c { bottom: 13%; left: 28%; }

	.visual-legenda {
		position: absolute;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: #b8d4e9;
		font-size: 0.59rem;
		font-weight: 800;
		letter-spacing: 1.5px;
	}

	.legenda-a {
		top: 17%;
		right: -1%;
	}

	.legenda-b {
		bottom: 18%;
		left: -2%;
	}

	.legenda-linha {
		width: 20px;
		height: 1px;
		background: #42b9f4;
	}

	.hero-rodape {
		position: absolute;
		z-index: 2;
		right: 0;
		bottom: 0;
		left: 0;
		display: flex;
		justify-content: space-between;
		padding: 1rem max(calc((100% - 1120px) / 2), 5%);
		border-top: 1px solid rgba(255, 255, 255, 0.1);
		color: #91a9c0;
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 1.7px;
	}

	/* CONTEÚDO */

	.contato-conteudo {
		position: relative;
		padding: 6rem 0 7rem;
		overflow: hidden;
		background:
			radial-gradient(circle at 0% 15%, rgba(22, 168, 234, 0.06), transparent 28%),
			radial-gradient(circle at 100% 85%, rgba(8, 102, 232, 0.05), transparent 28%),
			#f7faff;
	}

	.conteudo-cabecalho {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 3rem;
		margin-bottom: 3rem;
		animation: contatoTextoEntrada 0.8s ease both;
	}

	.conteudo-cabecalho h2 {
		margin: 0.7rem 0 0;
		color: #12365b;
		font-family: 'Space Grotesk', sans-serif;
		font-size: clamp(2.2rem, 4vw, 3.3rem);
		font-weight: 800;
		letter-spacing: -1.8px;
	}

	.conteudo-cabecalho h2 span {
		color: #0874e8;
	}

	.conteudo-cabecalho > p {
		max-width: 410px;
		margin: 0 0 0.4rem;
		color: #6b7e94;
		font-size: 0.98rem;
		line-height: 1.8;
	}

	.grid-contato {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.7rem;
		align-items: stretch;
	}

	.contato-card {
		position: relative;
		display: flex;
		flex-direction: column;
		min-width: 0;
		padding: 2.3rem;
		overflow: hidden;
		border: 1px solid #e3ebf5;
		border-radius: 22px;
		background: linear-gradient(145deg, #fff 0%, #fafdff 100%);
		box-shadow: 0 12px 35px rgba(18, 54, 91, 0.055);
		transition: transform 0.4s ease, box-shadow 0.4s ease, border-color 0.4s ease;
		animation: contatoTextoEntrada 0.8s ease both;
	}

	.card-digital {
		animation-delay: 0.15s;
	}

	.contato-card::before {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 3px;
		background: linear-gradient(90deg, #0866e8, #16a8ea, #42b9f4);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.45s ease;
	}

	.contato-card:hover {
		transform: translateY(-9px);
		border-color: rgba(8, 102, 232, 0.25);
		box-shadow: 0 25px 55px rgba(18, 54, 91, 0.11);
	}

	.contato-card:hover::before {
		transform: scaleX(1);
	}

	.card-topo {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 2rem;
	}

	.card-icone {
		width: 54px;
		height: 54px;
		display: grid;
		place-items: center;
		border: 1px solid #dcecff;
		border-radius: 16px;
		background: linear-gradient(145deg, #edf6ff, #e4f5ff);
		color: #0874e8;
		transition: transform 0.35s ease, background 0.35s ease;
	}

	.contato-card:hover .card-icone {
		transform: rotate(-7deg) scale(1.08);
		background: #e0f3ff;
	}

	.card-icone svg {
		width: 25px;
		height: 25px;
	}

	.card-numero {
		color: #c5d5e7;
		font-family: 'Space Grotesk', sans-serif;
		font-size: 1.15rem;
		font-weight: 700;
	}

	.card-etiqueta {
		color: #0874e8;
		font-size: 0.67rem;
		font-weight: 800;
		letter-spacing: 1.8px;
	}

	.card-conteudo h3 {
		margin: 0.55rem 0 0.7rem;
		color: #12365b;
		font-family: 'Space Grotesk', sans-serif;
		font-size: 1.8rem;
		font-weight: 800;
		letter-spacing: -0.8px;
	}

	.card-descricao {
		max-width: 390px;
		margin: 0 0 1.8rem;
		color: #71839a;
		font-size: 0.93rem;
		line-height: 1.8;
	}

	/* ENDEREÇO */

	.endereco {
		display: grid;
		gap: 1.2rem;
		padding: 1.3rem;
		border: 1px solid #e8eff7;
		border-radius: 15px;
		background: #f7faff;
	}

	.endereco-linha {
		display: flex;
		align-items: flex-start;
		gap: 0.85rem;
	}

	.endereco-marcador {
		flex: 0 0 8px;
		width: 8px;
		height: 8px;
		margin-top: 6px;
		border-radius: 50%;
		background: #16a8ea;
		box-shadow: 0 0 0 4px rgba(22, 168, 234, 0.1);
	}

	.endereco-linha strong {
		display: block;
		margin-bottom: 0.2rem;
		color: #12365b;
		font-size: 0.8rem;
		font-weight: 800;
	}

	.endereco-linha p {
		margin: 0;
		color: #6b7e94;
		font-size: 0.88rem;
		line-height: 1.6;
		overflow-wrap: anywhere;
	}

	/* CANAIS */

	.canal-item {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 0.9rem;
		padding: 1.1rem;
		border: 1px solid #e7eef7;
		border-radius: 14px;
		background: #f7faff;
		transition: transform 0.3s ease, border-color 0.3s ease, background 0.3s ease;
	}

	.canal-item:hover {
		transform: translateX(5px);
		border-color: rgba(8, 102, 232, 0.25);
		background: #eff7ff;
	}

	.canal-icone {
		flex: 0 0 43px;
		width: 43px;
		height: 43px;
		display: grid;
		place-items: center;
		border-radius: 12px;
		background: #e8f3ff;
		color: #0874e8;
	}

	.canal-icone svg {
		width: 21px;
		height: 21px;
	}

	.canal-info {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 0.3rem;
		min-width: 0;
	}

	.canal-info > span {
		color: #91a2b6;
		font-size: 0.62rem;
		font-weight: 800;
		letter-spacing: 1.5px;
	}

	.canal-info a,
	.canal-info p {
		margin: 0;
		color: #12365b;
		font-size: 0.9rem;
		font-weight: 700;
		text-decoration: none;
		overflow-wrap: anywhere;
		transition: color 0.3s ease;
	}

	.canal-info a:hover {
		color: #0874e8;
	}

	.canal-seta {
		color: #16a8ea;
		font-size: 1.1rem;
	}

	/* RODAPÉ DOS CARDS */

	.card-rodape {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-top: auto;
		padding-top: 1.5rem;
		border-top: 1px solid #eaf0f7;
		color: #9aacc0;
		font-size: 0.62rem;
