
---
import LayoutBase from '../layouts/LayoutBase.astro';
import Cartao from '../components/Cartao.astro';
import { empresa } from '../data/empresa.js';
---

<LayoutBase 
	titulo="Início" 
	descricao={`Bem-vindo à ${empresa.nome}. ${empresa.slogan}`}
>
	<section class="hero">
		<div class="hero-grade" aria-hidden="true"></div>
		<div class="hero-luz hero-luz-1" aria-hidden="true"></div>
		<div class="hero-luz hero-luz-2" aria-hidden="true"></div>

		<div class="container hero-layout">
			<div class="hero-texto">
				<div class="hero-selo">
					<span class="selo-ponto"></span>
					TECNOLOGIA <span>•</span> INOVAÇÃO <span>•</span> DESENVOLVIMENTO
				</div>

				<h1>
					Ideias em código,
					<span>soluções em realidade.</span>
				</h1>

				<div class="hero-linha"></div>

				<p class="hero-descricao">{empresa.missao}</p>

				<div class="hero-acoes">
					<a href="/contato" class="btn">
						Fale Conosco
						<span class="seta-btn">↗</span>
					</a>

					<a href="/sobre" class="link-sobre">
						Conheça a empresa
						<span>→</span>
					</a>
				</div>

				<div class="hero-assinatura">
					<span class="assinatura-linha"></span>
					<span>TECNOLOGIA QUE TRANSFORMA IDEIAS EM SOLUÇÕES</span>
				</div>
			</div>

			<div class="hero-visual" aria-label="Logomarca da YtaloCorps">
				<div class="visual-aura"></div>

				<div class="orbita orbita-externa"></div>
				<div class="orbita orbita-media"></div>
				<div class="orbita orbita-interna"></div>

				<div class="orbita-ponto ponto-1"></div>
				<div class="orbita-ponto ponto-2"></div>
				<div class="orbita-ponto ponto-3"></div>

				<div class="logo-painel">
					<div class="logo-reflexo"></div>
					<img src="/images/logo.png" alt="Logo da YtaloCorps" />
					<div class="logo-scan"></div>
				</div>

				<div class="visual-legenda">
					<span class="legenda-indicador"></span>
					<span>INNOVATION / DIGITAL SOLUTIONS</span>
				</div>

				<div class="visual-coordenada coordenada-1">YC / 01</div>
				<div class="visual-coordenada coordenada-2">TECHNOLOGY</div>
			</div>
		</div>

		<div class="hero-rodape">
			<span>YTALOCORPS</span>
			<span class="rodape-traco"></span>
			<span>IDEIAS QUE GANHAM VIDA</span>
		</div>
	</section>

	<section class="publico secao secao-alt">
		<div class="container">
			<h2>Quem Atendemos</h2>
			<Cartao>
				<p class="texto-publico">{empresa.publicoAlvo}</p>
			</Cartao>
		</div>
	</section>
</LayoutBase>

<style>
	/* ==========================================
	   HERO — NOVA IDENTIDADE VISUAL
	========================================== */

	.hero {
		position: relative;
		isolation: isolate;
		overflow: hidden;

		min-height: 690px;
		padding: 90px 0 105px;

		display: flex;
		align-items: center;

		background:
			radial-gradient(
				ellipse at 78% 48%,
				rgba(22, 168, 234, 0.13),
				transparent 34%
			),
			radial-gradient(
				ellipse at 10% 90%,
				rgba(8, 102, 232, 0.07),
				transparent 38%
			),
			linear-gradient(120deg, #ffffff 0%, #f5f9ff 52%, #eaf4ff 100%) !important;

		color: #12365b;
	}

	/* Remove os antigos efeitos do CSS global */

	.hero::before,
	.hero::after,
	.hero .container::before,
	.hero .container::after {
		content: none !important;
		display: none !important;
	}

	.hero-grade {
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		opacity: 0.42;

		background-image:
			linear-gradient(rgba(8, 102, 232, 0.045) 1px, transparent 1px),
			linear-gradient(90deg, rgba(8, 102, 232, 0.045) 1px, transparent 1px);

		background-size: 48px 48px;

		mask-image: linear-gradient(
			90deg,
			transparent,
			black 20%,
			black 85%,
			transparent
		);
	}

	.hero-luz {
		position: absolute;
		z-index: -1;
		border-radius: 50%;
		pointer-events: none;
		filter: blur(2px);
	}

	.hero-luz-1 {
		width: 340px;
		height: 340px;
		top: -220px;
		left: -100px;
		background: rgba(22, 168, 234, 0.09);
	}

	.hero-luz-2 {
		width: 450px;
		height: 450px;
		right: -250px;
		bottom: -280px;
		background: rgba(8, 102, 232, 0.09);
	}

	/* ==========================================
	   COMPOSIÇÃO PRINCIPAL
	========================================== */

	.hero-layout {
		position: relative;
		z-index: 2;

		width: min(90%, 1240px);
		margin-inline: auto;

		display: grid;
		grid-template-columns: 1.05fr 0.95fr;
		align-items: center;
		gap: 35px;
	}

	/* ==========================================
	   TEXTO
	========================================== */

	.hero-texto {
		position: relative;
		z-index: 3;
		animation: textoEntrada 1s cubic-bezier(.2, .7, .2, 1) both;
	}

	.hero-selo {
		display: inline-flex;
		align-items: center;
		gap: 9px;

		padding: 10px 15px;
		margin-bottom: 28px;

		border: 1px solid rgba(8, 102, 232, 0.13);
		border-radius: 50px;

		background: rgba(255, 255, 255, 0.76);
		backdrop-filter: blur(12px);

		color: #3975b6;
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 1.15px;

		box-shadow: 0 8px 24px rgba(25, 74, 130, 0.055);
	}

	.hero-selo > span:not(.selo-ponto) {
		color: #16a8ea;
	}

	.selo-ponto {
		width: 7px;
		height: 7px;
		flex: 0 0 7px;
		border-radius: 50%;
		background: #16a8ea;
		box-shadow: 0 0 12px rgba(22, 168, 234, 0.8);
		animation: pontoPulso 2s ease-in-out infinite;
	}

	.hero h1 {
		max-width: 660px;
		margin: 0 0 24px;

		color: #12365b !important;

		font-family: 'Space Grotesk', sans-serif;
		font-size: clamp(3.2rem, 5.1vw, 5.1rem);
		font-weight: 800;
		line-height: 1.04;
		letter-spacing: -0.065em;
		text-align: left;
		text-wrap: balance;
	}

	.hero h1 span {
		display: block;

		background: linear-gradient(
			100deg,
			#0759d8 0%,
			#1685f2 52%,
			#16a8ea 100%
		);

		background-clip: text;
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.hero-linha {
		width: 74px;
		height: 5px;
		margin: 0 0 24px;

		border-radius: 10px;
		background: linear-gradient(90deg, #0759d8, #16a8ea);

		box-shadow: 0 4px 15px rgba(8, 102, 232, 0.22);
	}

	.hero .hero-descricao {
		max-width: 570px;
		margin: 0 0 30px;

		color: #657991 !important;
		font-size: 1.08rem;
		line-height: 1.9;
		text-align: left;
	}

	/* ==========================================
	   BOTÕES
	========================================== */

	.hero-acoes {
		display: flex;
		align-items: center;
		gap: 25px;
		flex-wrap: wrap;
	}

	.hero .btn,
	.hero a.btn {
		min-height: 58px;
		padding: 0 25px;

		display: inline-flex;
		align-items: center;
		gap: 20px;

		border: 0 !important;
		border-radius: 14px;

		background: linear-gradient(110deg, #0759d8, #1685f2, #16a8ea) !important;
		color: #fff !important;

		font-size: 0.94rem;
		font-weight: 800;

		box-shadow: 0 12px 28px rgba(8, 102, 232, 0.23);
		transition: transform .3s ease, box-shadow .3s ease;
	}

	.hero .btn:hover {
		transform: translateY(-5px);
		box-shadow: 0 18px 36px rgba(8, 102, 232, 0.32);
	}

	.seta-btn {
		font-size: 1.2rem;
		transition: transform .3s ease;
	}

	.hero .btn:hover .seta-btn {
		transform: translate(3px, -3px);
	}

	.hero .link-sobre {
		display: inline-flex;
		align-items: center;
		gap: 9px;

		color: #315b83;
		font-size: 0.9rem;
		font-weight: 700;
	}

	.hero .link-sobre span {
		color: #087ce8;
		font-size: 1.2rem;
		transition: transform .3s ease;
	}

	.hero .link-sobre:hover {
		color: #087ce8;
	}

	.hero .link-sobre:hover span {
		transform: translateX(5px);
	}

	.hero-assinatura {
		display: flex;
		align-items: center;
		gap: 11px;
		margin-top: 55px;

		color: #8a9bb0;
		font-size: 0.63rem;
		font-weight: 800;
		letter-spacing: 1.6px;
	}

	.assinatura-linha {
		width: 27px;
		height: 2px;
		background: #16a8ea;
	}

	/* ==========================================
	   PALCO DA LOGO
	========================================== */

	.hero-visual {
		position: relative;

		width: 100%;
		max-width: 570px;
		aspect-ratio: 1 / 1;

		display: flex;
		align-items: center;
		justify-content: center;

		margin-inline: auto;

		animation: visualEntrada 1.2s .15s cubic-bezier(.2, .7, .2, 1) both;
	}

	.visual-aura {
		position: absolute;
		width: 68%;
		height: 68%;
		border-radius: 50%;

		background: radial-gradient(
			circle,
			rgba(22, 168, 234, 0.19),
			rgba(8, 102, 232, 0.07) 48%,
			transparent 72%
		);

		filter: blur(20px);
		animation: auraRespirar 5s ease-in-out infinite;
	}

	/* Painel central */

	.logo-painel {
		position: relative;
		z-index: 3;

		width: 76%;
		aspect-ratio: 1 / 0.78;

		display: flex;
		align-items: center;
		justify-content: center;

		overflow: hidden;

		border: 1px solid rgba(255, 255, 255, 0.95);
		border-radius: 32px;

		background:
			linear-gradient(
				145deg,
				rgba(255, 255, 255, 0.95),
				rgba(235, 246, 255, 0.78)
			);

		box-shadow:
			0 30px 80px rgba(23, 83, 145, 0.13),
			0 8px 24px rgba(8, 102, 232, 0.07),
			inset 0 0 0 1px rgba(8, 102, 232, 0.045);

		backdrop-filter: blur(18px);

		transform: rotate(-5deg);
		animation: painelFlutuar 7s ease-in-out infinite;
	}

	.logo-painel img {
		position: relative;
		z-index: 2;

		width: 86%;
		max-height: 85%;
		object-fit: contain;

		filter:
			drop-shadow(0 10px 18px rgba(8, 102, 232, 0.13));

		animation: logoRespirar 5s ease-in-out infinite;
	}

	.logo-reflexo {
		position: absolute;
		z-index: 1;
		top: -70%;
		left: -90%;

		width: 55%;
		height: 240%;

		background: linear-gradient(
			90deg,
			transparent,
			rgba(255, 255, 255, 0.72),
			transparent
		);

		transform: rotate(28deg);
		animation: reflexoPassar 6s ease-in-out infinite;
	}

	.logo-scan {
		position: absolute;
		z-index: 4;
		left: 0;
		top: -10%;

		width: 100%;
		height: 2px;

		background: linear-gradient(
			90deg,
			transparent,
			rgba(22, 168, 234, 0.7),
			transparent
		);

		box-shadow: 0 0 16px rgba(22, 168, 234, 0.35);
		animation: scanVertical 5s linear infinite;
	}

	/* ==========================================
	   ANÉIS ORBITAIS
	========================================== */

	.orbita {
		position: absolute;
		z-index: 1;

		border: 1px solid rgba(8, 102, 232, 0.17);
		border-radius: 50%;

		pointer-events: none;
	}

	.orbita-externa {
		width: 96%;
		height: 96%;
		border-style: dashed;
		border-color: rgba(8, 102, 232, 0.18);

		animation: orbitaGirar 35s linear infinite;
	}

	.orbita-media {
		width: 83%;
		height: 83%;
		border-color: rgba(22, 168, 234, 0.24);
		border-width: 2px;

		animation: orbitaGirar 24s linear infinite reverse;
	}

	.orbita-interna {
		width: 69%;
		height: 69%;
		border-style: dashed;
		border-color: rgba(8, 102, 232, 0.12);

		animation: orbitaGirar 40s linear infinite;
	}

	.orbita-ponto {
		position: absolute;
		z-index: 4;

		width: 13px;
		height: 13px;
		border: 3px solid #fff;
		border-radius: 50%;

		background: #16a8ea;
		box-shadow:
			0 0 0 5px rgba(22, 168, 234, 0.12),
			0 0 20px rgba(22, 168, 234, 0.6);
	}

	.ponto-1 {
		top: 15%;
		right: 22%;
		animation: pontoFlutuar 4s ease-in-out infinite;
	}

	.ponto-2 {
		bottom: 19%;
		left: 15%;
		width: 10px;
		height: 10px;
		background: #0866e8;
		animation: pontoFlutuar 5s ease-in-out infinite reverse;
	}

	.ponto-3 {
		top: 27%;
		left: 9%;
		width: 7px;
		height: 7px;
		animation: pontoFlutuar 3.5s ease-in-out infinite;
	}

	/* Informações decorativas */

	.visual-legenda {
		position: absolute;
		z-index: 5;
		bottom: 7%;
		left: 50%;
		transform: translateX(-50%);

		display: flex;
		align-items: center;
		gap: 9px;

		padding: 9px 15px;
		border: 1px solid rgba(8, 102, 232, 0.10);
		border-radius: 30px;

		background: rgba(255, 255, 255, 0.82);
		backdrop-filter: blur(12px);

		color: #64809f;
		font-size: 0.57rem;
		font-weight: 800;
		letter-spacing: 1.4px;
		white-space: nowrap;

		box-shadow: 0 7px 20px rgba(20, 70, 120, 0.07);
	}

	.legenda-indicador {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: #16a8ea;
		box-shadow: 0 0 10px rgba(22, 168, 234, 0.7);
	}

	.visual-coordenada {
		position: absolute;
		z-index: 5;

		color: #83a0bd;
		font-size: 0.58rem;
		font-weight: 800;
		letter-spacing: 1.8px;
	}

	.coordenada-1 {
		top: 13%;
		left: 12%;
	}

	.coordenada-2 {
		right: 8%;
		bottom: 23%;
		writing-mode: vertical-rl;
	}

	/* ==========================================
	   RODAPÉ VISUAL DO HERO
	========================================== */

	.hero-rodape {
		position: absolute;
		right: 5%;
		bottom: 25px;

		display: flex;
		align-items: center;
		gap: 12px;

		color: #8ca1b9;
		font-size: 0.58rem;
		font-weight: 800;
		letter-spacing: 1.7px;
	}

	.rodape-traco {
		width: 35px;
		height: 1px;
		background: #16a8ea;
	}

	/* ==========================================
	   QUEM ATENDEMOS
	========================================== */

	.publico h2 {
		margin-bottom: 2rem;
	}

	.texto-publico {
		margin-bottom: 0;
		font-size: 1.125rem;
		color: var(--cor-texto-secundario);
	}

	/* ==========================================
	   ANIMAÇÕES
	========================================== */

	@keyframes textoEntrada {
		from {
			opacity: 0;
			transform: translateX(-35px);
		}
		to {
			opacity: 1;
			transform: translateX(0);
		}
	}

	@keyframes visualEntrada {
		from {
			opacity: 0;
			transform: translateX(35px) scale(.92);
		}
		to {
			opacity: 1;
			transform: translateX(0) scale(1);
		}
	}

	@keyframes painelFlutuar {
		0%, 100% {
			transform: translateY(0) rotate(-5deg);
		}
		50% {
			transform: translateY(-15px) rotate(-2deg);
		}
	}

	@keyframes logoRespirar {
		0%, 100% {
			transform: scale(1);
		}
		50% {
			transform: scale(1.035);
		}
	}

	@keyframes orbitaGirar {
		from {
			transform: rotate(0deg);
		}
		to {
			transform: rotate(360deg);
		}
	}

	@keyframes auraRespirar {
		0%, 100% {
			transform: scale(.9);
			opacity: .65;
		}
		50% {
			transform: scale(1.12);
			opacity: 1;
		}
	}

	@keyframes reflexoPassar {
		0%, 20% {
			left: -90%;
		}
		55%, 100% {
			left: 140%;
		}
	}

	@keyframes scanVertical {
		from {
			top: -5%;
			opacity: 0;
		}
		10% {
			opacity: 1;
		}
		90% {
			opacity: 1;
		}
		to {
			top: 105%;
			opacity: 0;
		}
	}

	@keyframes pontoPulso {
		0%, 100% {
			transform: scale(1);
			opacity: .8;
		}
		50% {
			transform: scale(1.35);
			opacity: 1;
		}
	}

	@keyframes pontoFlutuar {
		0%, 100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-11px);
		}
	}

	/* ==========================================
	   RESPONSIVIDADE
	========================================== */

	@media (max-width: 1000px) {
		.hero {
			min-height: 650px;
		}

		.hero-layout {
			gap: 10px;
			grid-template-columns: 1fr 0.9fr;
		}

		.hero h1 {
			font-size: clamp(2.8rem, 5.5vw, 4rem);
		}

		.hero-visual {
			max-width: 470px;
		}

		.visual-coordenada {
			font-size: 0.5rem;
		}
	}

	@media (max-width: 760px) {
		.hero {
			min-height: auto;
			padding: 75px 0 85px;
		}

		.hero-layout {
			grid-template-columns: 1fr;
			gap: 30px;
		}

		.hero-texto {
			text-align: center;
		}

		.hero-selo {
			margin-bottom: 23px;
			font-size: 0.59rem;
		}

		.hero h1 {
			max-width: 620px;
			margin-inline: auto;
			font-size: clamp(2.8rem, 9vw, 4.3rem);
			text-align: center;
		}

		.hero-linha {
			margin: 0 auto 22px;
		}

		.hero .hero-descricao {
			max-width: 600px;
			margin-inline: auto;
			text-align: center;
			font-size: 1rem;
		}

		.hero-acoes {
			justify-content: center;
		}

		.hero-assinatura {
			justify-content: center;
			margin-top: 32px;
			font-size: 0.54rem;
		}

		.hero-visual {
			width: min(100%, 480px);
			margin-top: 0;
		}

		.hero-rodape {
			display: none;
		}
	}

	@media (max-width: 480px) {
		.hero {
			padding: 60px 0 65px;
		}

		.hero-selo {
			gap: 6px;
			padding: 9px 11px;
			font-size: 0.51rem;
			letter-spacing: .7px;
		}

		.hero h1 {
			font-size: clamp(2.45rem, 10vw, 3.2rem);
			letter-spacing: -.055em;
		}

		.hero .hero-descricao {
			font-size: .95rem;
			line-height: 1.8;
		}

		.hero-acoes {
			flex-direction: column;
			gap: 17px;
		}

		.hero .btn {
			width: 100%;
			max-width: 320px;
			justify-content: center;
		}

		.hero-visual {
			width: 112%;
			margin-left: -6%;
		}

		.logo-painel {
			border-radius: 23px;
		}

		.visual-legenda {
			bottom: 5%;
			font-size: .47rem;
		}

		.visual-coordenada {
			font-size: .43rem;
		}

		.hero-assinatura {
			font-size: .46rem;
			letter-spacing: 1px;
		}
	}

	/* Acessibilidade */

	@media (prefers-reduced-motion: reduce) {
		.hero *,
		.hero *::before,
		.hero *::after {
			animation: none !important;
			transition: none !important;
		}
	}
</style>
